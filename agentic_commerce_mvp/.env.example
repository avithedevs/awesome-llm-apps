# Agentic Commerce MVP - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===================================
# LLM Provider API Keys
# ===================================
OPENAI_API_KEY=sk-proj-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
GOOGLE_API_KEY=your-gemini-key-here
XAI_API_KEY=your-xai-key-here

# ===================================
# Database Configuration
# ===================================
DATABASE_URL=postgresql://user:password@localhost:5432/agentic_commerce
REDIS_URL=redis://localhost:6379/0

# ===================================
# Vector Database (Optional)
# ===================================
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=product-embeddings

# ===================================
# Payment Processing
# ===================================
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ===================================
# Application Settings
# ===================================
APP_ENV=development
APP_SECRET_KEY=your-secret-key-minimum-32-chars
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ===================================
# Agent Configuration
# ===================================
DEFAULT_LLM_MODEL=gpt-4o-mini
EXPENSIVE_LLM_MODEL=gpt-4o
CHEAP_LLM_MODEL=gemini-2.0-flash-exp
MAX_AGENT_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=30

# ===================================
# External Services
# ===================================
SENDGRID_API_KEY=your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ===================================
# Monitoring & Observability
# ===================================
SENTRY_DSN=https://your-sentry-dsn
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=agentic-commerce-mvp

# ===================================
# Feature Flags (true/false)
# ===================================
ENABLE_AI_NEGOTIATION=true
ENABLE_PRODUCT_RECOMMENDATIONS=true
ENABLE_REAL_TIME_INVENTORY=true
ENABLE_MULTI_CURRENCY=false

# ===================================
# Rate Limiting
# ===================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===================================
# Cache Settings
# ===================================
CACHE_TTL_SECONDS=300
ENABLE_RESPONSE_CACHE=true

# ===================================
# Development Tools
# ===================================
DEBUG=true
LOG_LEVEL=INFO
PRETTY_LOGS=true
